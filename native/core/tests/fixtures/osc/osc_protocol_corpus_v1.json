{
  "schema_version": "ianvs-osc-corpus-v1",
  "encoding": "lowercase-hex",
  "description": "Shared byte-level OSC edge corpus. The Dart mirror must remain byte-for-byte equivalent.",
  "cases": [
    {
      "id": "bel_terminator",
      "coverage": ["BEL terminator"],
      "protocol": "OSC 8",
      "wire": {
        "chunks_hex": [
          "1b5d383b69643d62656c3b68747470733a2f2f6578616d706c652e746573742f62656c07"
        ]
      },
      "terminator": "BEL",
      "expected": {
        "semantic_intent": "hyperlink_open",
        "state_effect": "hyperlink id=bel opens",
        "reply": "none",
        "must_not_crash": true
      }
    },
