#!/bin/sh
# Public fixture operations. Only the App's approved SSH command invokes these.
set -eu
state=/home/lab/.mobile-prd
case "${1:-}" in
  fail)
    printf '%s\n' 'dev-box: configuration is missing (fixture only).' >&2
    exit 2
    ;;
  repair)
    mkdir -p "$state"
    printf x >>"$state/repairs"
    printf '%s\n' 'enabled=true' >"$state/config"
    printf '%s\n' 'TRAIL_FIXTURE_REPAIRED: dev-box configuration is ready.'
    ;;
  status)
    if [ -f "$state/config" ]; then cat "$state/config"; else exit 2; fi
    ;;
  *) printf '%s\n' 'usage: trail-fixture fail|repair|status' >&2; exit 64 ;;
esac
