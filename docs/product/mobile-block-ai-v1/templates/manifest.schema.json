{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trail mobile PRD evidence manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "baseline_commit",
    "implementation_commit",
    "stages",
    "environments",
    "source_hashes",
    "shared_artifacts",
    "open_issues",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "baseline_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "implementation_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "stages": {
      "type": "object",
      "required": [
        "S1",
        "S2",
        "S3",
        "S4"
      ],
      "additionalProperties": false,
      "properties": {
        "S1": {
          "enum": [
            "planned",
            "in_progress",
            "implemented_unverified",
            "blocked",
            "failed",
            "verified"
          ]
        },
        "S2": {
          "enum": [
            "planned",
            "in_progress",
            "implemented_unverified",
            "blocked",
            "failed",
            "verified"
          ]
        },
        "S3": {
          "enum": [
            "planned",
            "in_progress",
            "implemented_unverified",
            "blocked",
            "failed",
            "verified"
          ]
        },
        "S4": {
          "enum": [
            "planned",
            "in_progress",
            "implemented_unverified",
            "blocked",
            "failed",
            "verified"
          ]
        }
      }
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "platform",
          "capture_class",
          "device_model",
          "os_version",
          "flutter_version",
          "build_mode",
          "build_id",
          "build_commit",
          "is_physical"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "capture_class": {
            "enum": [
              "widget_golden",
              "app_simulator",
              "app_physical",
              "app_desktop"
            ]
          },
          "platform": {
            "enum": [
              "ios",
              "ipados",
              "macos",
              "widget"
            ]
          },
          "is_physical": {
            "type": "boolean"
          },
          "build_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "source_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "shared_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "open_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "core_flow",
          "description"
        ],
        "properties": {
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "core_flow": {
            "type": "boolean"
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48,
      "items": {
        "type": "object",
        "required": [
          "id",
          "requirement_ids",
          "status",
          "steps",
          "observed_result",
          "assertions",
          "artifacts",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[1-4]-T[0-9]{2}$"
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^S[1-4]-R[0-9]{2}$"
            }
          },
          "status": {
            "enum": [
              "not_run",
              "blocked",
              "failed",
              "passed"
            ]
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "observed_result": {
            "type": [
              "string",
              "null"
            ]
          },
          "assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "expected",
                "actual",
                "passed",
                "proof_path"
              ],
              "properties": {
                "passed": {
                  "type": "boolean"
                }
              }
            }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/artifact"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "additional_cases": {
      "type": "array"
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "kind",
        "path",
        "sha256",
        "implementation_commit",
        "captured_at"
      ],
      "properties": {
        "kind": {
          "enum": [
            "screenshot",
            "video",
            "log",
            "trace",
            "metrics",
            "semantic_tree"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "implementation_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "modified": {
          "type": "boolean"
        },
        "role": {
          "type": "string"
        },
        "environment_id": {
          "type": "string"
        },
        "pixel_size": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "viewport_logical": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2
        },
        "pixel_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "shot_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^S[1-4]-T[0-9]{2}-F[0-9]{2}$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "screenshot",
                  "video"
                ]
              }
            }
          },
          "then": {
            "required": [
              "environment_id",
              "role",
              "modified"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "screenshot"
              }
            }
          },
          "then": {
            "required": [
              "pixel_size",
              "viewport_logical",
              "pixel_ratio",
              "orientation",
              "locale",
              "theme",
              "font_policy",
              "keyboard",
              "description"
            ]
          }
        }
      ]
    }
  }
}
