From 3b70a20107b52b4a268851f3b1f5ccb986aaced6 Mon Sep 17 00:00:00 2001
From: binghuiluo <binghuiluo@tencent.com>
Date: Fri, 30 Oct 2026 13:06:05 +0800
Subject: [PATCH] fix: backport bounded reading tables preserving M05 styles

---
 CHANGELOG.md                        |   6 +
 lib/src/ianvs_markdown.dart         |  19 ++-
 test/mobile_table_reading_test.dart | 232 ++++++++++++++++++++++++++++
 3 files changed, 255 insertions(+), 2 deletions(-)
 create mode 100644 test/mobile_table_reading_test.dart

diff --git a/CHANGELOG.md b/CHANGELOG.md
index 87a91d7..c51e82a 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -1,3 +1,9 @@
+## Unreleased
+
+- Backport bounded, text-scale-aware reading table columns and visible horizontal
+  scrollbars. Preserve M05 ordered-marker measurement and host scrollbar overrides;
+  long prose and links wrap without intrinsic layout queries.
+
 ## 0.3.1
 
 - Add opt-in `IanvsMarkdownSyntaxPreset.standard` to the standalone
diff --git a/lib/src/ianvs_markdown.dart b/lib/src/ianvs_markdown.dart
index 279fe98..f65ee98 100644
--- a/lib/src/ianvs_markdown.dart
+++ b/lib/src/ianvs_markdown.dart
@@ -256,8 +256,13 @@ class IanvsMarkdown extends StatelessWidget {
                 ));
     }
 
-    final effectiveStyleSheet =
-        (styleSheet ?? ianvsMarkdownStyleSheet(context, colors)).copyWith();
+    final baseStyleSheet =
+        styleSheet ?? ianvsMarkdownStyleSheet(context, colors);
+    // flutter_markdown_plus copyWith does not retain this nullable field.
+    final effectiveStyleSheet = baseStyleSheet.copyWith(
+      tableScrollbarThumbVisibility:
+          baseStyleSheet.tableScrollbarThumbVisibility,
+    );
     if (syntaxPreset == IanvsMarkdownSyntaxPreset.standard) {
       return _buildStandardMarkdown(
         context,
@@ -880,6 +885,8 @@ class IanvsMarkdown extends StatelessWidget {
       selectable: blockSelectable,
       styleSheet: effectiveStyleSheet.copyWith(
         listIndent: _standardListIndent(context, source, effectiveStyleSheet),
+        tableScrollbarThumbVisibility:
+            effectiveStyleSheet.tableScrollbarThumbVisibility,
       ),
       styleSheetTheme: styleSheetTheme,
       onSelectionChanged: blockSelectable ? onSelectionChanged : null,
@@ -2314,6 +2321,14 @@ MarkdownStyleSheet ianvsMarkdownStyleSheet(
       fontSize: 14.5,
       height: 1.58,
     ),
+    // Bound each reading column instead of squeezing it into the viewport or
+    // measuring widget intrinsics (links can contain LayoutBuilder). Keep
+    // ordinary words readable at the host text scale; long cells wrap and the
+    // table scrolls horizontally when its columns exceed the available width.
+    tableColumnWidth: FixedColumnWidth(
+      MediaQuery.textScalerOf(context).scale(140) + 20,
+    ),
+    tableScrollbarThumbVisibility: true,
     tableBorder: TableBorder.all(color: colors.borderSoft),
     tableHead: TextStyle(
       color: colors.textPrimary,
diff --git a/test/mobile_table_reading_test.dart b/test/mobile_table_reading_test.dart
new file mode 100644
index 0000000..cea1c7b
--- /dev/null
+++ b/test/mobile_table_reading_test.dart
@@ -0,0 +1,232 @@
+import 'package:flutter/material.dart';
+import 'package:flutter/rendering.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:ianvs_markdown/ianvs_markdown.dart';
+
+void main() {
+  for (final width in [320.0, 390.0]) {
+    testWidgets('five-column table keeps short words intact at $width', (
+      tester,
+    ) async {
+      tester.view.devicePixelRatio = 1;
+      tester.view.physicalSize = Size(width, 700);
+      addTearDown(tester.view.reset);
+      await tester.pumpWidget(
+        MaterialApp(
+          theme: ThemeData(platform: TargetPlatform.iOS),
+          home: Scaffold(
+            body: const SingleChildScrollView(
+              child: IanvsMarkdown(
+                documentSelection: true,
+                data:
+                    '| Fruit | Color | Taste | Season | Origin |\n'
+                    '| --- | --- | --- | --- | --- |\n'
+                    '| Lemon | Yellow | Sour | Winter | Asia |\n'
+                    '| Apple | Red | Sweet | Autumn | Europe |',
+              ),
+            ),
+          ),
+        ),
+      );
+      await tester.pumpAndSettle();
+      for (final word in ['Season', 'Lemon', 'Yellow', 'Winter', 'Autumn']) {
+        final rich = find.byWidgetPredicate(
+          (widget) => widget is RichText && widget.text.toPlainText() == word,
+        );
+        expect(rich, findsOneWidget);
+        final paragraph = tester.renderObject<RenderParagraph>(rich);
+        final boxes = paragraph.getBoxesForSelection(
+          TextSelection(baseOffset: 0, extentOffset: word.length),
+        );
+        expect(boxes, hasLength(1), reason: '$word must stay on one line');
+      }
+      final horizontal = find.byWidgetPredicate(
+        (widget) =>
+            widget is SingleChildScrollView &&
+            widget.scrollDirection == Axis.horizontal,
+      );
+      expect(horizontal, findsOneWidget);
+      final scrollable = tester.state<ScrollableState>(
+        find
+            .descendant(of: horizontal, matching: find.byType(Scrollable))
+            .first,
+      );
+      expect(scrollable.position.maxScrollExtent, greaterThan(0));
+      await tester.drag(horizontal, const Offset(-500, 0));
+      await tester.pumpAndSettle();
+      expect(scrollable.position.pixels, greaterThan(0));
+      expect(
+        tester.getRect(find.byType(Table)).right,
+        lessThanOrEqualTo(width + 1),
+      );
+      expect(tester.takeException(), isNull);
+    });
+  }
+  for (final width in [320.0, 390.0, 1000.0]) {
+    for (final scale in [1.0, 2.0]) {
+      for (final direction in TextDirection.values) {
+        testWidgets(
+          'bounded reading cells wrap prose and links at $width/$scale/${direction.name}',
+          (tester) async {
+            tester.view.devicePixelRatio = 1;
+            tester.view.physicalSize = Size(width, 1200);
+            addTearDown(tester.view.reset);
+            final english = List.filled(8, 'Long readable prose').join(' ');
+            final chinese = List.filled(8, '中文长段落需要正常换行').join();
+            const label = 'Long link title with several words and 中文标题';
+            await tester.pumpWidget(
+              MaterialApp(
+                home: MediaQuery(
+                  data: MediaQueryData(textScaler: TextScaler.linear(scale)),
+                  child: Directionality(
+                    textDirection: direction,
+                    child: Scaffold(
+                      body: SingleChildScrollView(
+                        child: IanvsMarkdown(
+                          data:
+                              '| Season | Details | Link |\n| --- | --- | --- |\n| Winter | $english | [$label](docs/test.md) |\n| Autumn | $chinese | [External reference](https://example.com) |',
+                        ),
+                      ),
+                    ),
+                  ),
+                ),
+              ),
+            );
+            await tester.pumpAndSettle();
+            final table = tester.renderObject<RenderTable>(find.byType(Table));
+            expect(table.size.width, closeTo(3 * (140 * scale + 20), .01));
+            final link = tester.renderObject<RenderBox>(find.text(label));
+            final row = table.getRowBox(1);
+            final origin = link.localToGlobal(Offset.zero, ancestor: table);
+            expect(link.size.height, greaterThan(30 * scale));
+            expect(
+              origin.dy + link.size.height,
+              lessThanOrEqualTo(row.bottom + .01),
+            );
+            // Paragraphs stay finite and wrap even on a wide desktop viewport.
+            for (final text in [english, chinese]) {
+              final finder = find.byWidgetPredicate(
+                (w) => w is RichText && w.text.toPlainText() == text,
+              );
+              final paragraph = tester.renderObject<RenderParagraph>(
+                finder.first,
+              );
+              expect(
+                paragraph.size.width,
+                lessThanOrEqualTo(140 * scale + .01),
+              );
+              expect(paragraph.size.height, greaterThan(30 * scale));
+            }
+            final horizontal = find.byWidgetPredicate(
+              (w) =>
+                  w is SingleChildScrollView &&
+                  w.scrollDirection == Axis.horizontal,
+            );
+            final scrollable = tester.state<ScrollableState>(
+              find
+                  .descendant(of: horizontal, matching: find.byType(Scrollable))
+                  .first,
+            );
+            if (table.size.width > width) {
+              expect(scrollable.position.maxScrollExtent, greaterThan(0));
+              // A direct jump verifies the far edge is laid out, including RTL.
+              scrollable.position.jumpTo(scrollable.position.maxScrollExtent);
+              await tester.pumpAndSettle();
+              expect(scrollable.position.extentAfter, closeTo(0, .01));
+            } else {
+              expect(scrollable.position.maxScrollExtent, 0);
+            }
+            final tableController = tester
+                .widget<SingleChildScrollView>(horizontal)
+                .controller;
+            final bar = tester.widget<Scrollbar>(
+              find.byWidgetPredicate(
+                (w) => w is Scrollbar && w.controller == tableController,
+              ),
+            );
+            expect(bar.thumbVisibility, isTrue);
+            expect(tester.takeException(), isNull);
+          },
+        );
+      }
+    }
+  }
+
+  testWidgets('standard GFM tables use the same bounded reading policy', (
+    tester,
+  ) async {
+    await tester.pumpWidget(
+      const MaterialApp(
+        home: Scaffold(
+          body: SizedBox(
+            width: 320,
+            child: IanvsMarkdown(
+              syntaxPreset: IanvsMarkdownSyntaxPreset.standard,
+              data:
+                  '| Fruit | Color | Taste | Season | Origin |\n| --- | --- | --- | --- | --- |\n| Lemon | Yellow | Sour | Winter | Asia |',
+            ),
+          ),
+        ),
+      ),
+    );
+    await tester.pumpAndSettle();
+    expect(tester.getSize(find.byType(Table)).width, 800);
+    final horizontal = find.byWidgetPredicate(
+      (w) => w is SingleChildScrollView && w.scrollDirection == Axis.horizontal,
+    );
+    final scrollable = tester.state<ScrollableState>(
+      find.descendant(of: horizontal, matching: find.byType(Scrollable)).first,
+    );
+    expect(scrollable.position.maxScrollExtent, greaterThan(0));
+    final controller = tester
+        .widget<SingleChildScrollView>(horizontal)
+        .controller;
+    expect(
+      tester
+          .widget<Scrollbar>(
+            find.byWidgetPredicate(
+              (w) => w is Scrollbar && w.controller == controller,
+            ),
+          )
+          .thumbVisibility,
+      isTrue,
+    );
+    expect(tester.takeException(), isNull);
+  });
+
+  testWidgets(
+    'reading table honors explicit host column and scrollbar styles',
+    (tester) async {
+      await tester.pumpWidget(
+        MaterialApp(
+          home: Scaffold(
+            body: Builder(
+              builder: (context) => IanvsMarkdown(
+                data: '| A | B |\n| --- | --- |\n| one | two |',
+                styleSheet:
+                    ianvsMarkdownStyleSheet(
+                      context,
+                      IanvsMarkdownThemeData.light,
+                    ).copyWith(
+                      tableColumnWidth: const FixedColumnWidth(110),
+                      tableScrollbarThumbVisibility: false,
+                    ),
+              ),
+            ),
+          ),
+        ),
+      );
+      await tester.pumpAndSettle();
+      expect(tester.getSize(find.byType(Table)).width, 220);
+      expect(
+        tester
+            .widgetList<Scrollbar>(find.byType(Scrollbar))
+            .where((bar) => bar.controller != null)
+            .single
+            .thumbVisibility,
+        isFalse,
+      );
+      expect(tester.takeException(), isNull);
+    },
+  );
+}
